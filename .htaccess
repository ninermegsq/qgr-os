# ------------------------------------------------------------------
# Q GRAOS — configuracao para Apache (Hostinger, cPanel, Locaweb...)
# ------------------------------------------------------------------

# Pagina de erro personalizada
ErrorDocument 404 /404.html

# Pagina inicial padrao
DirectoryIndex index.html

# Nao lista o conteudo das pastas
Options -Indexes

# ------------------------------------------------------------------
# Arquivos internos bloqueados
# O site publico e so a raiz: os HTML, o CSS, os JS, as imagens, o
# robots.txt, o sitemap.xml e a pasta admin/. Nada de material interno
# (historico do Git, credenciais do painel, variaveis de ambiente,
# migrations do banco e ferramentas de desenvolvimento).
#
# O bloqueio e feito por Rewrite, antes de qualquer leitura de arquivo:
# o "Redirect 404" do modulo mod_alias nao pega arquivos .htaccess
# (o Apache os trata antes), por isso a regra fica aqui.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Qualquer arquivo ou pasta que comece com ponto:
    # .git, .gitignore, .gitattributes, .qg-admin.json, .env, .env.local
    RewriteRule "(^|/)\." - [F,L]

    # Pastas internas de desenvolvimento e de infraestrutura
    RewriteRule "^(supabase|tools|node_modules)(/|$)" - [F,L]

    # Arquivos internos da raiz
    RewriteRule "^(package\.json|package-lock\.json)$" - [F,L]
</IfModule>

# ------------------------------------------------------------------
# Compressao (deixa o site mais leve)
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------
# Cache do navegador
# ------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                "access plus 1 hour"
    ExpiresByType text/css                 "access plus 7 days"
    ExpiresByType application/javascript   "access plus 7 days"
    ExpiresByType text/plain               "access plus 7 days"
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------
# Content-Security-Policy
# O site nao usa CDN nem script inline (so JSON-LD, que a CSP ignora
# como script), mas usa handler inline de onload/onerror: por isso
# 'unsafe-inline' em script-src. A fonte vem do Google Fonts.
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ------------------------------------------------------------------
# Cabecalhos de seguranca
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------------
# O painel administrativo nunca fica em cache compartilhado
# (o Netlify ja faz isso pela regra /admin/*; aqui a regra e pelo
# caminho da requisicao, para valer em qualquer subpasta)
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    SetEnvIf Request_URI "^/admin(/|$)" QG_PAINEL=1
    Header always set Cache-Control "no-store, max-age=0" env=QG_PAINEL
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=QG_PAINEL
</IfModule>

# ------------------------------------------------------------------
# Forca HTTPS (comente estas linhas se o SSL ainda nao estiver ativo)
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
